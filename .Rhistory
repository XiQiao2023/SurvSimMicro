pairwise_smd <- function(df) {
stopifnot(ncol(df) == 3)
smd <- function(p1, p2) {
pooled_sd <- sqrt((p1 * (1 - p1) + p2 * (1 - p2)) / 2)
abs(p1 - p2) / pooled_sd
}
data.frame(
smd_12 = smd(df[[1]], df[[2]]),
smd_13 = smd(df[[1]], df[[3]]),
smd_23 = smd(df[[2]], df[[3]])
)
}
