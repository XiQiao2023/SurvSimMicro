respondent_first = first_name
),
quiet = FALSE
)
# Move the rendered file out of Round1/ and into Round1/Output/
rendered <- file.path(dirname(TEMPLATE), out_name)
if (file.exists(rendered)) {
file.rename(rendered, file.path(OUT_DIR, out_name))
} else {
warning("Expected output not found: ", rendered)
}
}
message("Done. Files written to: ", OUT_DIR)
